# ============================================================
# Plan-B Systems SIEM Stack v2 – Per-Client Configuration
# Copy to config.env and fill in values before running install.sh
# ============================================================

# ── Site Identity ──────────────────────────────────────────
# Client/site name (alphanumeric + hyphens, used in labels)
CLIENT_NAME=client-name-here
# Unique site identifier from Plan-B portal
CLIENT_ID=SITE-0001

# ── Network ────────────────────────────────────────────────
# Static IP of the host machine (used for TLS cert and access)
HOST_IP=192.168.1.100

# ── Timezone ───────────────────────────────────────────────
TIMEZONE=Asia/Jerusalem

# ── Dashboard ──────────────────────────────────────────────
# Admin password for the web dashboard (min 8 chars)
DASHBOARD_PASSWORD=ChangeMe!SecurePassword123
# Dashboard web port
DASHBOARD_PORT=3000

# ── Syslog Ports ───────────────────────────────────────────
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=1514

# ── Retention & Storage ────────────────────────────────────
# How many days of logs to keep (730 = 2 years, Israeli regulation minimum)
RETENTION_DAYS=730
# External data path (leave empty for Docker volumes)
DATA_PATH=
# OpenSearch heap size (quarter of total RAM, e.g. 2g for 8GB host)
OPENSEARCH_HEAP_SIZE=2g
# Disk watermarks
DISK_WATERMARK_HIGH=85
DISK_WATERMARK_FLOOD=92

# ── Web UI Bind Address ──────────────────────────────────
# Set to LAN IP to restrict access (default 0.0.0.0 = all interfaces)
BIND_ADDRESS=0.0.0.0

# ── License ────────────────────────────────────────────────
LICENSE_API_URL=https://siemsys.plan-b.systems/api/license/check
GRACE_PERIOD_DAYS=7
# Client secret for authenticated API calls (provided by Plan-B portal)
CLIENT_SECRET=

# ── TLS Certificate ────────────────────────────────────────
CERT_COUNTRY=IL
CERT_STATE=Tel_Aviv
CERT_CITY=Tel_Aviv
CERT_ORG=Plan-B_Systems
CERT_OU=SIEM

# ═══════════════════════════════════════════════════════════
# GENERATED BY install.sh – DO NOT EDIT MANUALLY
# ═══════════════════════════════════════════════════════════
# JWT_SECRET=
# DASHBOARD_PASSWORD_HASH=
