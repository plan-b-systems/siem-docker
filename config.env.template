# ============================================================
# Plan-B Systems SIEM Stack v2 – Per-Client Configuration
# Copy to config.env and fill in values before running install.sh
# ============================================================

# ── Site Identity ──────────────────────────────────────────
# Client/site name (alphanumeric + hyphens, used in labels)
CLIENT_NAME=client-name-here
# Unique site identifier from Plan-B portal
CLIENT_ID=SITE-0001

# ── Network ────────────────────────────────────────────────
# Static IP of the host machine (used for TLS cert and access)
HOST_IP=192.168.1.100

# ── Timezone ───────────────────────────────────────────────
TIMEZONE=Asia/Jerusalem

# ── Dashboard ──────────────────────────────────────────────
# Initial admin password for the web dashboard (min 12 chars when possible).
# The installer hashes this into DASHBOARD_PASSWORD_HASH below. On first
# login the default 'admin' user is forced to change this password and
# enrol MFA before anything else is accessible.
DASHBOARD_PASSWORD=ChangeMe!SecurePassword123
# Dashboard web port
DASHBOARD_PORT=3000
# Set to 1 when a TLS-terminating reverse proxy is fronting the container.
# Leave unset/empty for plain HTTP bring-up — the session cookie will not
# be marked 'secure' in that case so it still works over http://.
COOKIE_SECURE=
# Absolute URL used in password-reset email links. Leave empty to auto-build
# from the Host header; set explicitly when behind a reverse proxy.
PUBLIC_URL=

# ── SMTP (optional — enables self-service password-reset emails) ──
# If unset, reset links are only written to the dashboard container log
# so the admin can retrieve them via SSH ('docker logs plan-b-dashboard').
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@plan-b.systems

# ── Syslog Ports ───────────────────────────────────────────
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=1514

# ── Retention & Storage ────────────────────────────────────
# How many days of logs to keep (730 = 2 years, Israeli regulation minimum)
RETENTION_DAYS=730
# External data path (leave empty for Docker volumes)
DATA_PATH=
# OpenSearch heap size (quarter of total RAM, e.g. 2g for 8GB host)
OPENSEARCH_HEAP_SIZE=2g
# Disk watermarks
DISK_WATERMARK_HIGH=85
DISK_WATERMARK_FLOOD=92

# ── Web UI Bind Address ──────────────────────────────────
# Set to LAN IP to restrict access (default 0.0.0.0 = all interfaces)
BIND_ADDRESS=0.0.0.0

# ── License ────────────────────────────────────────────────
LICENSE_API_URL=https://siemsys.plan-b.systems/api/license/check
GRACE_PERIOD_DAYS=7
# Client secret for authenticated API calls (provided by Plan-B portal)
CLIENT_SECRET=

# ── TLS Certificate ────────────────────────────────────────

# ═══════════════════════════════════════════════════════════
